# Anthropic API key for the plate scanner — get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Redis (Upstash). If you add Upstash through the Vercel marketplace these are
# set for you; the code accepts either the KV_* or UPSTASH_* naming.
KV_REST_API_URL=https://....upstash.io
KV_REST_API_TOKEN=...
